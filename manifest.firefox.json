{
  "manifest_version": 3,
  "name": "Chordwiki-AutoScroller",
  "version": "1.0.12",
  "description": "Auto-scrolling, duration lookup, and utility features for chord and lyrics pages.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://ja.chordwiki.org/wiki/*",
    "https://ja.chordwiki.org/wiki.cgi?c=view*",
    "https://musicbrainz.org/*",
    "https://itunes.apple.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chordwiki-autoscroller@xiace-lite",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
